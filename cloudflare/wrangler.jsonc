{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-ai-edge",
  "main": "worker.js",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
