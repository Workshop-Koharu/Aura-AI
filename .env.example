# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DB_URL=

# Inference gateway (server-side only)
# Existing Vercel projects may provide AURA_INFERENCE_URL and AURA_GATEWAY_SECRET.
AURA_MODEL_API_URL=
AURA_MODEL_API_KEY=

# Kaggle CLI authentication is configured in the local user environment.
# KAGGLE_API_TOKEN is never a model inference endpoint.

# Public application metadata
NEXT_PUBLIC_APP_URL=https://aura.koharu.live
