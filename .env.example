# Safe local defaults only; never put real secrets in this file.
AURA_ENVIRONMENT=development
AURA_CORS_ORIGINS=http://localhost:3000,https://aura.koharu.live
# OpenAI-compatible chat provider configuration. Add the real API key only in Render environment settings.
AURA_MODEL_API_KEY=
AURA_MODEL_BASE_URL=https://api.openai.com/v1
AURA_MODEL_NAME=gpt-4o-mini
